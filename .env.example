# OpenAlex "polite pool" identifier - recommended, unlocks faster/more reliable rate limits for /api/search/openalex
OPENALEX_MAILTO=

# Unpaywall contact email - required for /api/resolve (Unpaywall requires an email on every request); missing this returns 503
UNPAYWALL_EMAIL=

# Semantic Scholar API key - optional, raises rate limits for /api/search/s2 beyond the shared anonymous pool.
# Also reused by /api/citations (S2 references passthrough for the citation-flow view) - no separate key needed.
S2_API_KEY=

# NCBI/PubMed API key - optional, raises rate limits for /api/search/pubmed (E-utilities) beyond the shared anonymous pool
NCBI_API_KEY=
